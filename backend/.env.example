# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Connection string for Redis (locks de assento, cache do catálogo, filas BullMQ).
REDIS_URL="redis://localhost:6379"

# JWT signing secrets. Use two different long random strings (e.g. `openssl rand -hex 32`).
# Never reuse the access secret for the refresh token or vice versa.
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_REFRESH_EXPIRES_IN="7d"

# Signs the QR code payload embedded in each Ticket (RF-13) — a separate
# secret so a leaked ticket QR can't be used to forge an access/refresh
# token or vice versa. Use `openssl rand -hex 32`.
TICKET_QR_SECRET="replace-with-a-different-long-random-string"

# TMDB (https://www.themoviedb.org/settings/api) — use the v4 "Read Access Token", sent as a Bearer token.
TMDB_API_KEY="replace-with-your-tmdb-v4-read-access-token"
TMDB_BASE_URL="https://api.themoviedb.org/3"
TMDB_TIMEOUT_MS="5000"
TMDB_MAX_RETRIES="3"
TMDB_RETRY_BASE_MS="300"
# How often the BullMQ job re-syncs the local Movie cache from TMDB (ms). Default: 6h.
TMDB_SYNC_INTERVAL_MS="21600000"

# Base URL used to build the shareable link returned by GET /reviews/:id/share.
# No public web frontend exists yet — this is just a stable, configurable prefix.
SHARE_BASE_URL="https://cineverse.example"

# How long an atomic seat hold (Redis, RNF-08) survives before expiring and
# freeing the seat back up. Default: 5 minutes.
SEAT_LOCK_TTL_SECONDS="300"

# Session reminder push (RF-17). How far ahead of a purchased session's
# start time the reminder fires, and how often the job checks for due
# reminders. Defaults: 24h lead time, checked every 15 min.
SESSION_REMINDER_HOURS_BEFORE="24"
SESSION_REMINDER_INTERVAL_MS="900000"